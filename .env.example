# ==============================================================================
# VANTA AI - ENVIRONMENT VARIABLE TEMPLATE (.env.example)
# Copy this file to .env.local for local development.
# Configure production secrets in GitHub Repository Secrets & Environment Secrets.
# DO NOT COMMIT REAL PLAINTEXT SECRETS TO GIT.
# ==============================================================================

# --- DATABASE & CORE APPLICATION ---
DATABASE_URL="postgresql://user:password@localhost:5432/vanta_db?schema=public"
AUTH_SECRET="vanta_auth_secret_dev_key_change_in_production_2026"
NEXTAUTH_SECRET="vanta_auth_secret_dev_key_change_in_production_2026"
APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NODE_ENV="development"

# --- REDIS & QUEUE CACHE ---
REDIS_URL="redis://localhost:6379"

# --- AI PROVIDERS & MODEL ENGINES ---
GEMINI_API_KEY=""
FAL_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# --- PAYMENTS & STRIPE BILLING ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- OAUTH AUTHENTICATION PROVIDERS ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- OBJECT STORAGE (CLOUDFLARE R2 & AWS S3) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="vanta-media-assets"

AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
S3_BUCKET_NAME="vanta-media-bucket"

# --- MODEL CONTEXT PROTOCOL & DIAGNOSTICS ---
MCP_CLIENT_SECRET=""
MCP_OAUTH_SECRET=""
SENTRY_DSN=""
